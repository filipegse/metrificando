# Jira Cloud
JIRA_BASE_URL=https://SEU-SITE.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Segredo enviado pela Jira Automation no header X-Webhook-Token
WEBHOOK_TOKEN=

# Postgres (Netlify DB / Neon). O Netlify DB define NETLIFY_DATABASE_URL automaticamente.
DATABASE_URL=

# Proteção provisória por senha (até o login com Google Workspace)
APP_USUARIO=
APP_SENHA=

# TeamRetro (health check). Chave de API da conta: Settings → API.
TEAMRETRO_API_KEY=
